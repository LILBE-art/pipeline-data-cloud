# Copy this file to .env and adapt it:  cp .env.example .env
# .env is ignored by Git. NEVER commit real passwords or AWS keys.

# --- General ---------------------------------------------------------------
LOG_LEVEL=INFO
RANDOM_SEED=42
NUM_ORDERS=5000

# --- PostgreSQL ------------------------------------------------------------
# LOAD_TO_POSTGRES=true loads the Silver data into PostgreSQL after the run
# (same as the --load-db flag). Docker Compose enables it for the app container.
LOAD_TO_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=pipeline
# Placeholder only: choose your own local password.
POSTGRES_PASSWORD=change_me_locally
# The pipeline waits for the database: number of attempts and seconds between them.
DB_CONNECT_RETRIES=30
DB_CONNECT_DELAY_SECONDS=2

# --- AWS S3 (optional, disabled by default) -----------------------------------
S3_ENABLED=false
S3_BUCKET=
S3_PREFIX=ecommerce-pipeline
AWS_REGION=eu-west-3
# AWS credentials do NOT belong here. Use `aws configure`, `aws configure sso`
# or an IAM role: boto3 finds them automatically.
